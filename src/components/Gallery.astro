---
const gallery = [
  { url: "/images/gym-image-11.webp", span: "col-span-2 row-span-1 md:col-span-8 md:row-span-2", alt: "Full commercial gym with imported strength equipment" },
  { url: "/images/gym-image-1.webp", span: "col-span-1 row-span-2 md:col-span-4 md:row-span-1", alt: "Imported commercial strength machines" },
  { url: "/images/gym-image-12.webp", span: "col-span-1 row-span-1 md:col-span-4 md:row-span-1", alt: "Commercial cardio zone with imported treadmills" },
  { url: "/images/gym-image-13.webp", span: "col-span-1 row-span-1 md:col-span-4 md:row-span-1", alt: "Imported functional training rig setup" },
  { url: "/images/gym-image-14.webp", span: "col-span-2 row-span-1 md:col-span-8 md:row-span-1", alt: "Complete imported free weights section" },
];
---
<section id="gallery" class="py-16 md:py-24 lg:py-28 px-5 md:px-12">
  <div class="max-w-[1400px] mx-auto">
    
    <div class="mb-12 md:mb-20 flex flex-col md:flex-row gap-6 md:gap-8 justify-between items-start md:items-end">
      <div>
        <div data-animate="fade-up" class="text-accent text-xs md:text-sm font-bold tracking-[0.2em] uppercase mb-3 md:mb-4">Gallery</div>
        <h2 data-animate="fade-up" style="--stagger:1" class="text-4xl md:text-[4rem] font-bold tracking-tight md:tracking-[-0.03em] leading-tight text-white">Premium Collection.</h2>
      </div>
      <p class="text-text-muted max-w-sm text-base md:text-lg leading-relaxed font-medium">
        Explore a curated selection of premium commercial equipment and imported goods available for your business.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-12 gap-3 md:gap-4 auto-rows-[160px] md:auto-rows-[200px] lg:auto-rows-[240px]">
      {gallery.map((img) => (
        <div data-animate="scale-in" class={`relative rounded-[1.5rem] md:rounded-[2.5rem] overflow-hidden group ${img.span}`}>
          <img 
            src={img.url} 
            alt={img.alt} 
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-[2s] ease-out" 
          />
          <div class="absolute inset-0 bg-black/10 group-hover:bg-black/30 transition-colors duration-500"></div>
          <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500">
            <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-accent/20 backdrop-blur-md flex items-center justify-center text-accent scale-75 group-hover:scale-100 transition-transform duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="md:w-6 md:h-6"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
