---
---
<section id="catalogue" class="py-16 md:py-24 lg:py-32 px-5 md:px-12 relative">
  <div class="max-w-[1400px] mx-auto">
    <div class="relative rounded-[2rem] md:rounded-[3rem] lg:rounded-[4rem] bg-gradient-to-br from-accent to-[#b8860b] p-8 sm:p-12 md:p-16 lg:p-24 overflow-hidden flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-20 shadow-2xl group">
      
      <!-- Ambient effects -->
      <div class="absolute inset-0 bg-[url('/images/gym-image-2.webp')] opacity-10 mix-blend-overlay object-cover w-full h-full pointer-events-none"></div>
      <div class="absolute top-[-20%] right-[-10%] w-[50%] h-[50%] bg-white/20 blur-[120px] rounded-full pointer-events-none"></div>
      <div class="absolute bottom-[-20%] left-[-10%] w-[40%] h-[40%] bg-black/20 blur-[100px] rounded-full pointer-events-none"></div>
      
      <!-- Content -->
      <div class="relative z-20 w-full lg:w-[55%] flex flex-col items-center lg:items-start text-center lg:text-left text-black">
        
        <h2 data-animate="fade-up" class="text-4xl sm:text-5xl md:text-[4.5rem] lg:text-[5rem] font-black tracking-tighter leading-[1] md:leading-[0.95] mb-6 md:mb-8 drop-shadow-sm">
          Get The Full Catalogue.
        </h2>
        
        <p data-animate="fade-up" style="--stagger:1" class="text-black/80 text-base sm:text-lg md:text-xl mb-8 md:mb-12 font-semibold max-w-xl leading-relaxed">
          Explore our complete range of premium global imports. Access full specifications, dimensions, and direct-factory wholesale pricing designed for scale.
        </p>
        
        <div data-animate="fade-up" style="--stagger:2" class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
          <a href="/fortura-catalogue.pdf" download class="group/btn relative inline-flex items-center justify-center gap-4 w-full sm:w-auto bg-black text-white px-8 md:px-10 py-4 md:py-5 rounded-full text-base md:text-lg font-bold overflow-hidden shadow-xl shadow-black/20 hover:shadow-2xl hover:shadow-black/30 transition-all duration-300 hover:-translate-y-1">
            <div class="absolute inset-0 bg-white/10 translate-y-full group-hover/btn:translate-y-0 transition-transform duration-300 ease-out"></div>
            <span class="relative z-10 flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="md:w-6 md:h-6 group-hover/btn:animate-bounce"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              Download PDF
            </span>
          </a>
        </div>
      </div>

      <!-- Enhanced Floating Visual (3D Stack) -->
      <div data-animate="fade-left" style="--stagger:2" class="relative z-20 w-full lg:w-[25%] flex justify-center perspective-[1200px] mt-2 mb-10 lg:mt-0 lg:mb-0">
        <div class="relative w-64 sm:w-72 md:w-80 lg:w-96 aspect-[1/1.4] transition-all duration-700 ease-out transform lg:rotate-y-[-15deg] lg:rotate-x-[10deg] group-hover:rotate-y-0 group-hover:rotate-x-0 group-hover:scale-105">
          
          <!-- Shadow -->
          <div class="absolute -bottom-8 -right-8 w-full h-full bg-black/20 blur-2xl rounded-3xl transition-all duration-700 group-hover:blur-xl group-hover:bg-black/30 pointer-events-none"></div>
          
          <!-- Back Card -->
          <div class="absolute inset-0 bg-white/40 backdrop-blur-md rounded-2xl md:rounded-3xl border border-white/50 translate-x-4 translate-y-4 -rotate-3 transition-transform duration-700 group-hover:translate-x-6 group-hover:translate-y-6 group-hover:-rotate-6 pointer-events-none"></div>
          
          <!-- Middle Card -->
          <div class="absolute inset-0 bg-white/60 backdrop-blur-md rounded-2xl md:rounded-3xl border border-white/60 translate-x-2 translate-y-2 -rotate-1 transition-transform duration-700 group-hover:translate-x-3 group-hover:translate-y-3 group-hover:-rotate-2 pointer-events-none"></div>
          
          <!-- Front Cover -->
          <div class="absolute inset-0 bg-black text-white rounded-2xl md:rounded-3xl shadow-2xl flex flex-col overflow-hidden border border-white/10 z-10 transition-transform duration-700 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:rotate-0">
            <div class="p-6 md:p-8 flex flex-col justify-between h-full bg-gradient-to-b from-black to-zinc-900">
             
              
              <div class="mt-auto space-y-4">
                <h3 class="text-3xl md:text-4xl font-black leading-tight tracking-tighter">
                  Global <span class="text-accent">Imports</span><br/>Collection
                </h3>
                <div class="w-full h-[1px] bg-white/20"></div>
                <div class="flex justify-between items-center text-xs font-bold text-white/50 uppercase tracking-wider">
                  <span>Specifications</span>
                  <span>Wholesale</span>
                </div>
              </div>
            </div>
            
            <!-- Cover Image Detail -->
            <div class="h-[45%] w-full relative">
              <img src="/images/gym-image-3.webp" class="w-full h-full object-cover grayscale mix-blend-luminosity opacity-80" alt="Catalogue Cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent pointer-events-none"></div>
            </div>
          </div>
          
        </div>
      </div>
      
    </div>
  </div>
</section>
