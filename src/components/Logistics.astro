---
---
<section id="importing" class="relative py-16 md:py-24 lg:py-28 px-5 md:px-12 overflow-hidden">
  <!-- Background layers -->
  <div class="absolute inset-0 z-0">
    <img src="/images/gym-image-17.webp" alt="Global Shipping and Logistics" class="w-full h-full object-cover opacity-15" />
    <div class="absolute inset-0 bg-gradient-to-b from-background via-background/90 to-background"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-background via-transparent to-background hidden md:block"></div>
    <div class="absolute inset-0" style="background-image: radial-gradient(circle, var(--dot-color) 1px, transparent 1px); background-size: var(--dot-gap) var(--dot-gap);"></div>
  </div>

  <!-- Ambient glows -->
  <div class="absolute top-[-15%] left-[-5%] w-[400px] h-[400px] bg-accent/[0.03] rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-[-10%] right-[-5%] w-[350px] h-[350px] bg-accent/[0.03] rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-[1400px] mx-auto relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-20 items-center">
      
      <!-- Content -->
      <div class="flex flex-col">
        <div data-animate="fade-up" class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-accent/[0.06] backdrop-blur-md w-max mb-6">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          <span class="text-accent text-[10px] md:text-xs font-bold tracking-[0.15em] uppercase">Licensed Direct Importer</span>
        </div>
        
        <h2 data-animate="fade-up" style="--stagger:1" class="text-4xl md:text-[4rem] font-bold tracking-tight leading-[1.1] text-white mb-4 md:mb-6">
          Premium Goods,<br/>
          <span class="text-gradient-gold">Imported Right.</span>
        </h2>
        <p data-animate="fade-up" style="--stagger:2" class="text-base md:text-xl text-text-muted mb-10 leading-relaxed font-medium max-w-lg">
          While we specialize in commercial gym equipment, our expertise covers a wide range of premium global imports. Our team manages every step — from international factory sourcing to customs clearance and pan-India doorstep delivery for any large-scale requirement.
        </p>

        <!-- Process Steps -->
        <div data-animate="fade-up" style="--stagger:3" class="flex flex-col gap-6 mb-10">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent shrink-0 mt-0.5">
              <span class="text-sm font-black">01</span>
            </div>
            <div>
              <p class="text-white font-bold text-base mb-1">Factory Sourcing</p>
              <p class="text-text-muted text-sm font-medium">Direct partnerships with gym equipment factories in China & Taiwan</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent shrink-0 mt-0.5">
              <span class="text-sm font-black">02</span>
            </div>
            <div>
              <p class="text-white font-bold text-base mb-1">Customs Clearance</p>
              <p class="text-text-muted text-sm font-medium">Complete import documentation, duties & port clearance handled by us</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent shrink-0 mt-0.5">
              <span class="text-sm font-black">03</span>
            </div>
            <div>
              <p class="text-white font-bold text-base mb-1">Equipment Customisation</p>
              <p class="text-text-muted text-sm font-medium">Custom branding, colors & configurations tailored to your gym</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent shrink-0 mt-0.5">
              <span class="text-sm font-black">04</span>
            </div>
            <div>
              <p class="text-white font-bold text-base mb-1">Delivery & Installation</p>
              <p class="text-text-muted text-sm font-medium">Pan-India dispatch with professional on-site assembly</p>
            </div>
          </div>
        </div>

        <div data-animate="fade-up" style="--stagger:4" class="flex flex-wrap gap-10 md:gap-14">
          <div class="flex flex-col gap-1">
            <p class="text-3xl md:text-4xl font-black text-white tracking-tighter">100%</p>
            <p class="text-xs md:text-sm text-text-muted font-bold uppercase tracking-wide">Pan-India<br/>Coverage</p>
          </div>
          <div class="flex flex-col gap-1">
            <p class="text-3xl md:text-4xl font-black text-white tracking-tighter">B2B</p>
            <p class="text-xs md:text-sm text-text-muted font-bold uppercase tracking-wide">Wholesale<br/>Only</p>
          </div>
          <div class="flex flex-col gap-1">
            <p class="text-3xl md:text-4xl font-black text-accent tracking-tighter">30-40%</p>
            <p class="text-xs md:text-sm text-text-muted font-bold uppercase tracking-wide">Lower Than<br/>Retail</p>
          </div>
        </div>
      </div>

      <!-- Enhanced 4-Image Bento Grid -->
      <div data-animate="fade-right" style="--stagger:2" class="grid grid-cols-2 md:grid-cols-3 grid-rows-3 md:grid-rows-2 gap-3 sm:gap-4 h-[650px] md:h-[600px] lg:h-[700px] w-full">
        <!-- Image 1: Shipping (Wide) -->
        <div class="rounded-[1.5rem] md:rounded-[2rem] overflow-hidden relative group shadow-2xl col-span-2 md:col-span-2 row-span-1 md:row-span-1">
          <img src="/images/gym-image-18.webp" alt="Cargo ship containers" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s]" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4">
            <div class="w-8 h-8 md:w-9 md:h-9 rounded-xl bg-accent/15 backdrop-blur flex items-center justify-center mb-1.5 md:mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <p class="text-white font-bold text-sm md:text-base tracking-tight leading-tight">Sea Freight</p>
            <p class="text-white/50 text-[10px] md:text-xs font-medium mt-0.5 hidden sm:block leading-tight">Direct port imports</p>
          </div>
        </div>
        
        <!-- Image 2: Warehouse (Tall) -->
        <div class="rounded-[1.5rem] md:rounded-[2rem] overflow-hidden relative group shadow-2xl col-span-1 md:col-span-1 row-span-2 md:row-span-2">
          <img src="/images/gym-image-9.webp" alt="Warehouse inventory" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s]" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4">
            <div class="w-8 h-8 md:w-9 md:h-9 rounded-xl bg-accent/15 backdrop-blur flex items-center justify-center mb-1.5 md:mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            </div>
            <p class="text-white font-bold text-sm md:text-base tracking-tight leading-tight">Bulk Inventory</p>
            <p class="text-white/50 text-[10px] md:text-xs font-medium mt-0.5 hidden sm:block leading-tight">Ready-to-ship stock</p>
          </div>
        </div>

        <!-- Image 3: Logistics (Square) -->
        <div class="rounded-[1.5rem] md:rounded-[2rem] overflow-hidden relative group shadow-2xl col-span-1 md:col-span-1 row-span-1 md:row-span-1">
          <img src="/images/gym-image-6.webp" alt="Logistics delivery trucks" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s]" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4">
            <div class="w-8 h-8 md:w-9 md:h-9 rounded-xl bg-accent/15 backdrop-blur flex items-center justify-center mb-1.5 md:mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5"/><path d="M14 17h1"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
            </div>
            <p class="text-white font-bold text-sm md:text-base tracking-tight leading-tight">Transit</p>
            <p class="text-white/50 text-[10px] md:text-xs font-medium mt-0.5 hidden sm:block leading-tight">Nationwide delivery</p>
          </div>
        </div>

        <!-- Image 4: Final Setup (Square) -->
        <div class="rounded-[1.5rem] md:rounded-[2rem] overflow-hidden relative group shadow-2xl col-span-1 md:col-span-1 row-span-1 md:row-span-1">
          <img src="/images/gym-image-19.webp" alt="Premium commercial space" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s]" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4">
            <div class="w-8 h-8 md:w-9 md:h-9 rounded-xl bg-accent/15 backdrop-blur flex items-center justify-center mb-1.5 md:mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <p class="text-white font-bold text-sm md:text-base tracking-tight leading-tight">Final Handover</p>
            <p class="text-white/50 text-[10px] md:text-xs font-medium mt-0.5 hidden sm:block leading-tight">Complete setup & delivery</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
