---
---
<section id="contact" class="py-16 md:py-24 lg:py-28 px-5 md:px-12">
  <div class="max-w-[1400px] mx-auto bg-surface rounded-[2rem] md:rounded-[4rem] p-5 sm:p-8 md:p-16 lg:p-20 relative overflow-hidden">
    
    <!-- Ambient glow -->
    <div class="absolute top-[-20%] right-[-10%] w-[400px] h-[400px] bg-accent/[0.04] rounded-full blur-[120px] pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
      
      <!-- Contact Info -->
      <div class="flex flex-col">
        <div data-animate="fade-up" class="text-accent text-xs md:text-sm font-bold tracking-[0.2em] uppercase mb-4">Get in Touch</div>
        <h2 data-animate="fade-up" style="--stagger:1" class="text-4xl md:text-[4.5rem] font-bold tracking-tight md:tracking-[-0.03em] mb-8 md:mb-10 text-white leading-tight">Let's Build<br/>Your Facility.</h2>
        <p class="text-text-muted mb-10 md:mb-14 max-w-sm text-base md:text-xl leading-relaxed font-medium">
          Ready to equip your gym with world-class imported equipment? Reach out for bulk pricing, detailed specifications, custom layouts, and import consultation.
        </p>

        <div data-animate="fade-up" style="--stagger:2" class="space-y-8 md:space-y-10 flex-1">
          <div class="flex items-start gap-5">
            <div class="w-12 h-12 rounded-2xl bg-accent/10 flex items-center justify-center text-accent shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <p class="text-[10px] md:text-xs text-text-muted mb-1.5 font-bold tracking-[0.15em] uppercase">Phone</p>
              <p class="text-base sm:text-lg md:text-2xl font-bold text-white tracking-tight">+91 85901 35663 <br class="sm:hidden" /><span class="hidden sm:inline">/</span> +91 82810 66462</p>
            </div>
          </div>

          <div class="flex items-start gap-5">
            <div class="w-12 h-12 rounded-2xl bg-accent/10 flex items-center justify-center text-accent shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div>
              <p class="text-[10px] md:text-xs text-text-muted mb-1.5 font-bold tracking-[0.15em] uppercase">Email</p>
              <p class="text-base sm:text-lg md:text-2xl font-bold text-white tracking-tight break-all">Forturaglobalexim<br class="md:hidden" />@gmail.com</p>
            </div>
          </div>

          <div class="flex items-start gap-5">
            <div class="w-12 h-12 rounded-2xl bg-accent/10 flex items-center justify-center text-accent shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <p class="text-[10px] md:text-xs text-text-muted mb-1.5 font-bold tracking-[0.15em] uppercase">Headquarters</p>
              <p class="text-base sm:text-lg md:text-xl font-bold text-white tracking-tight leading-snug max-w-[280px]">Cherpulassery, near municipality building,<br/>Palakkad, Kerala 679503</p>
              <p class="text-text-muted text-sm font-medium mt-1">Fortura global exim (OPC) private limited</p>
            </div>
          </div>
          <div class="flex items-start gap-5">
            <div class="w-12 h-12 rounded-2xl bg-accent/10 flex items-center justify-center text-accent shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </div>
            <div>
              <p class="text-[10px] md:text-xs text-text-muted mb-1.5 font-bold tracking-[0.15em] uppercase">Instagram</p>
              <a href="https://www.instagram.com/fortura_official?igsh=ZDZvenlxNGk5Zmpv" target="_blank" rel="noopener noreferrer" class="text-base sm:text-lg md:text-2xl font-bold text-white tracking-tight hover:text-accent transition-colors">@fortura_official</a>
            </div>
          </div>
        </div>

        <a href="https://wa.me/919778388901" target="_blank" rel="noopener noreferrer" class="mt-10 md:mt-16 flex items-center justify-center gap-3 bg-[#25D366] text-black px-8 py-4 md:px-10 md:py-5 rounded-full font-bold transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-[#25D366]/20 w-full sm:w-max text-base md:text-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          WhatsApp Inquiry
        </a>
      </div>

      <!-- Form -->
      <div data-animate="fade-up" style="--stagger:3" class="bg-background rounded-[1.5rem] md:rounded-[3rem] p-5 sm:p-8 md:p-12 lg:p-16 shadow-2xl">
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-2 text-white tracking-tight">Send an Inquiry</h3>
        <p class="text-text-muted text-sm md:text-base font-medium mb-8 md:mb-10">For bulk orders, facility planning, or import consultation</p>
        <form class="space-y-5 md:space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 md:gap-6">
            <div class="space-y-2">
              <label for="fname" class="text-[10px] md:text-xs font-bold text-text-muted uppercase tracking-[0.15em]">First Name</label>
              <input type="text" id="fname" class="w-full bg-surface rounded-xl md:rounded-2xl px-4 md:px-5 py-3 md:py-4 text-white focus:outline-none focus:ring-2 focus:ring-accent/30 transition-all text-sm md:text-base" placeholder="John" />
            </div>
            <div class="space-y-2">
              <label for="lname" class="text-[10px] md:text-xs font-bold text-text-muted uppercase tracking-[0.15em]">Last Name</label>
              <input type="text" id="lname" class="w-full bg-surface rounded-xl md:rounded-2xl px-4 md:px-5 py-3 md:py-4 text-white focus:outline-none focus:ring-2 focus:ring-accent/30 transition-all text-sm md:text-base" placeholder="Doe" />
            </div>
          </div>
          <div class="space-y-2">
            <label for="email" class="text-[10px] md:text-xs font-bold text-text-muted uppercase tracking-[0.15em]">Email Address</label>
            <input type="email" id="email" class="w-full bg-surface rounded-xl md:rounded-2xl px-4 md:px-5 py-3 md:py-4 text-white focus:outline-none focus:ring-2 focus:ring-accent/30 transition-all text-sm md:text-base" placeholder="john@example.com" />
          </div>
          <div class="space-y-2">
            <label for="phone" class="text-[10px] md:text-xs font-bold text-text-muted uppercase tracking-[0.15em]">Phone Number</label>
            <input type="tel" id="phone" class="w-full bg-surface rounded-xl md:rounded-2xl px-4 md:px-5 py-3 md:py-4 text-white focus:outline-none focus:ring-2 focus:ring-accent/30 transition-all text-sm md:text-base" placeholder="+91 98765 43210" />
          </div>
          <div class="space-y-2">
            <label for="message" class="text-[10px] md:text-xs font-bold text-text-muted uppercase tracking-[0.15em]">Requirements</label>
            <textarea id="message" rows="4" class="w-full bg-surface rounded-xl md:rounded-2xl px-4 md:px-5 py-3 md:py-4 text-white focus:outline-none focus:ring-2 focus:ring-accent/30 transition-all resize-none text-sm md:text-base" placeholder="Tell us about your facility, equipment needs..."></textarea>
          </div>
          <button type="submit" class="w-full bg-accent hover:bg-accent-hover text-black font-black py-4 md:py-5 rounded-xl md:rounded-2xl transition-all mt-2 text-base md:text-xl shadow-xl shadow-accent/10 active:scale-[0.98] hover:-translate-y-0.5">
            Submit Inquiry
          </button>
        </form>
      </div>

    </div>

  </div>
</section>
