---
const testimonials = [
  {
    quote: "Fortura completely transformed how we source our machines. The direct factory pricing saved us over 35% on our new 10,000 sq ft facility.",
  },
  {
    quote: "Their logistics team handled everything from customs clearance to final installation seamlessly. We didn't have to lift a finger.",
  },
  {
    quote: "The quality of the imported strength equipment is phenomenal. It rivals the top international brands at a fraction of the cost.",
  },
  {
    quote: "I recommend Fortura to all my corporate clients setting up employee fitness centers. Their product selection is unmatched globally.",
  },
  {
    quote: "A completely transparent import process. We received regular updates while our container was in transit, and delivery was exactly on time.",
  }
];
---

<section id="testimonials" class="py-24 px-5 md:px-12 relative overflow-hidden">
  <div class="max-w-[1200px] mx-auto relative z-10">
    <div class="text-center mb-16">
      <div data-animate="fade-up" class="inline-flex items-center gap-2 px-4 py-2 bg-accent/10 rounded-full mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
        <span class="text-xs font-bold text-accent tracking-[0.15em] uppercase">
          Client Feedback
        </span>
      </div>
      <h2 data-animate="fade-up" style="--stagger:1" class="text-4xl sm:text-5xl md:text-[4rem] font-bold text-white tracking-tight leading-[1.1] mb-6">
        What Our <br class="hidden sm:block"/><span class="text-gradient-gold">Partners Say.</span>
      </h2>
      <p class="text-lg text-text-muted max-w-2xl mx-auto font-medium">
        Trusted by top commercial gym owners, corporate wellness directors, and fitness facility managers globally and across India.
      </p>
    </div>

    <!-- Enhanced Animated Testimonial Card -->
    <div class="max-w-4xl mx-auto">
      <div data-animate="fade-up" style="--stagger:2" class="bg-gradient-to-br from-white/5 to-white/[0.02] backdrop-blur-2xl border border-white/10 rounded-[2.5rem] p-8 sm:p-12 shadow-[0_20px_50px_rgba(0,0,0,0.5)] relative overflow-hidden group min-h-[350px] flex flex-col justify-center">
        <!-- Ambient Background Effects -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-accent/10 rounded-full blur-[100px] pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-white/5 rounded-full blur-[100px] pointer-events-none"></div>
        
        <!-- Decorative Quote Mark -->
        <div class="absolute top-8 left-8 md:top-12 md:left-12 opacity-10">
          <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
        </div>
        
        <div class="relative z-10 w-full flex flex-col items-center text-center">
          
          <div id="testimonial-content" class="transition-all duration-500 opacity-100 translate-y-0 flex flex-col items-center">
            
            <!-- Quote Text -->
            <blockquote id="active-quote" class="text-xl md:text-3xl lg:text-[2rem] font-bold text-white mb-8 leading-[1.4] tracking-tight max-w-3xl min-h-[120px] flex items-center justify-center">
              "{testimonials[0].quote}"
            </blockquote>
            
          </div>
          
          <!-- Navigation Controls -->
          <div class="flex flex-col items-center w-full mt-8 gap-8">
            <div class="flex gap-4">
              <button
                id="btn-prev"
                class="w-12 h-12 rounded-full bg-white/5 hover:bg-accent hover:text-black border border-white/10 flex items-center justify-center transition-all duration-300 group shadow-lg backdrop-blur-md"
                aria-label="Previous testimonial"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <button
                id="btn-next"
                class="w-12 h-12 rounded-full bg-white/5 hover:bg-accent hover:text-black border border-white/10 flex items-center justify-center transition-all duration-300 group shadow-lg backdrop-blur-md"
                aria-label="Next testimonial"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </div>
            
            <!-- Progress Indicators -->
            <div class="flex justify-center gap-2" id="indicators">
              {testimonials.map((_, index) => (
                <button
                  class={`indicator-btn h-2 rounded-full transition-all duration-500 ${
                    index === 0 
                      ? "w-8 bg-accent shadow-[0_0_10px_rgba(212,175,55,0.5)]" 
                      : "w-2 bg-white/20 hover:bg-white/40"
                  }`}
                  data-index={index}
                  aria-label={`Go to testimonial ${index + 1}`}
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const testimonials = [
    {
      quote: "Fortura completely transformed how we source our machines. The direct factory pricing saved us over 35% on our new 10,000 sq ft facility.",
    },
    {
      quote: "Their logistics team handled everything from customs clearance to final installation seamlessly. We didn't have to lift a finger.",
    },
    {
      quote: "The quality of the imported strength equipment is phenomenal. It rivals the top international brands at a fraction of the cost.",
    },
    {
      quote: "I recommend Fortura to all my corporate clients setting up employee fitness centers. Their product selection is unmatched globally.",
    },
    {
      quote: "A completely transparent import process. We received regular updates while our container was in transit, and delivery was exactly on time.",
    }
  ];

  let currentIndex = 0;
  let intervalId;

  // DOM Elements
  const contentWrapper = document.getElementById('testimonial-content');
  const activeQuote = document.getElementById('active-quote');
  
  const indicators = document.querySelectorAll('.indicator-btn');

  const btnPrev = document.getElementById('btn-prev');
  const btnNext = document.getElementById('btn-next');

  function updateTestimonial(newIndex) {
    if (newIndex === currentIndex) return;
    
    // Fade out
    contentWrapper.style.opacity = '0';
    contentWrapper.style.transform = 'translateY(10px) scale(0.98)';
    
    setTimeout(() => {
      // Update data
      currentIndex = newIndex;
      const data = testimonials[currentIndex];
      
      activeQuote.textContent = `"${data.quote}"`;
      
      // Update Indicators
      indicators.forEach((ind, i) => {
        if(i === currentIndex) {
          ind.className = "indicator-btn h-2 rounded-full transition-all duration-500 w-8 bg-accent shadow-[0_0_10px_rgba(212,175,55,0.5)]";
        } else {
          ind.className = "indicator-btn h-2 rounded-full transition-all duration-500 w-2 bg-white/20 hover:bg-white/40";
        }
      });

      // Fade in
      contentWrapper.style.opacity = '1';
      contentWrapper.style.transform = 'translateY(0) scale(1)';
    }, 300);
  }

  function goNext() {
    updateTestimonial((currentIndex + 1) % testimonials.length);
    resetInterval();
  }

  function goPrev() {
    updateTestimonial((currentIndex - 1 + testimonials.length) % testimonials.length);
    resetInterval();
  }

  btnNext.addEventListener('click', goNext);
  btnPrev.addEventListener('click', goPrev);

  indicators.forEach(btn => {
    btn.addEventListener('click', () => {
      updateTestimonial(parseInt(btn.getAttribute('data-index')));
      resetInterval();
    });
  });

  function startInterval() {
    intervalId = setInterval(goNext, 6000);
  }

  function resetInterval() {
    clearInterval(intervalId);
    startInterval();
  }

  startInterval();
</script>
