---
const features = [
  { 
    title: "Imported Gym Equipment", 
    desc: "Commercial-grade treadmills, strength machines, functional rigs, and free weights — sourced directly from certified international factories.", 
    icon: "dumbbell", 
    image: "/images/gym-image-4.webp",
    span: "col-span-1 md:col-span-2 md:row-span-1 lg:col-span-2 lg:row-span-2",
    size: "large"
  },
  { 
    title: "Customs Clearance", 
    desc: "We handle all import documentation, duties, and port clearance so you don't have to.", 
    icon: "shield", 
    image: "/images/gym-image-5.webp",
    span: "col-span-1 md:col-span-1 md:row-span-1 lg:col-span-1 lg:row-span-1",
    size: "small"
  },
  { 
    title: "Pan-India Delivery", 
    desc: "From port to your facility — we manage the entire freight, warehousing, and last-mile delivery chain across India.", 
    icon: "truck", 
    image: "/images/gym-image-6.webp",
    span: "col-span-1 md:col-span-1 md:row-span-2 lg:col-span-1 lg:row-span-2",
    size: "tall"
  },
  { 
    title: "Equipment Customisation", 
    desc: "Custom branding, colors, and configurations to match your gym's identity.", 
    icon: "tool", 
    image: "/images/gym-image-7.webp",
    span: "col-span-1 md:col-span-1 md:row-span-1 lg:col-span-1 lg:row-span-1",
    size: "small"
  },
  { 
    title: "Customer-Friendly Team", 
    desc: "Dedicated, approachable staff who walk you through every step — selection to setup.", 
    icon: "users", 
    image: "/images/gym-image-8.webp",
    span: "col-span-1 md:col-span-1 md:row-span-1 lg:col-span-1 lg:row-span-1",
    size: "small"
  },
  { 
    title: "Wholesale B2B Pricing", 
    desc: "30-40% lower than retail — direct factory pricing passed on to you.", 
    icon: "package", 
    image: "/images/gym-image-9.webp",
    span: "col-span-1 md:col-span-1 md:row-span-1 lg:col-span-1 lg:row-span-1",
    size: "small"
  },
  {
    title: "Professional Installation",
    desc: "Our trained technicians handle on-site assembly, calibration, and setup of every machine at your facility.",
    icon: "tool",
    image: "/images/gym-image-10.webp",
    span: "col-span-1 md:col-span-2 md:row-span-1 lg:col-span-2 lg:row-span-1",
    size: "wide"
  }
];

const icons = {
  globe: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="md:w-9 md:h-9"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  dumbbell: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="md:w-7 md:h-7"><path d="M14.4 14.4 9.6 9.6"/><path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"/><path d="m21.5 21.5-1.4-1.4"/><path d="M3.9 3.9 2.5 2.5"/><path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l6.364 6.364a2 2 0 1 1-2.829 2.829l1.767 1.768a2 2 0 1 1 2.829 2.828z"/></svg>`,
  tool: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="md:w-7 md:h-7"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  truck: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="md:w-9 md:h-9"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5"/><path d="M14 17h1"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>`,
  shield: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="md:w-7 md:h-7"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2-1 4-2 7-2 2.5 0 4.5 1 6.5 2a1 1 0 0 1 1 1z"/></svg>`,
  package: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="md:w-7 md:h-7"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`,
  users: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="md:w-7 md:h-7"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`
};
---
<section class="py-16 md:py-24 lg:py-28 px-5 md:px-12">
  <div class="max-w-[1400px] mx-auto">
    
    <div class="mb-12 md:mb-20 text-center max-w-3xl mx-auto">
      <div data-animate="fade-up" class="text-accent text-xs md:text-sm font-bold tracking-[0.2em] uppercase mb-4">Why Choose Us</div>
      <h2 data-animate="fade-up" style="--stagger:1" class="text-4xl md:text-[5rem] font-bold tracking-tight text-white leading-[1.1] mb-6">
        Equipment & Import<br/>Excellence.
      </h2>
      <p class="text-base md:text-xl text-text-muted font-medium">
        Premium gym equipment combined with seamless importing, customs clearance, and a team that truly cares about your success.
      </p>
    </div>

    <!-- Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-4 auto-rows-[250px] md:auto-rows-[160px] lg:auto-rows-[200px]">
      
      {features.map((feature) => (
        <div data-animate="fade-up" class={`group relative rounded-[1.5rem] md:rounded-[2.5rem] p-6 md:p-8 flex flex-col justify-between overflow-hidden bg-surface transition-all duration-500 hover:bg-surface-hover ${feature.span}`}>
          
          <!-- Background Fading Image -->
          <img 
            src={feature.image} 
            alt={feature.title} 
            class="absolute inset-0 w-full h-full object-cover opacity-[0.55] group-hover:opacity-[0.85] group-hover:scale-105 transition-all duration-[1.5s] ease-out grayscale-[0.3] group-hover:grayscale-0" 
          />
          
          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/80 to-[#050505]/40 transition-opacity duration-500 group-hover:opacity-80"></div>
          <div class="absolute inset-0 bg-accent mix-blend-overlay opacity-10 group-hover:opacity-20 transition-opacity duration-500"></div>
          
          <!-- Icon -->
          <div class="relative z-10 w-11 h-11 md:w-13 md:h-13 rounded-2xl bg-accent/10 backdrop-blur-md flex items-center justify-center text-accent group-hover:-translate-y-1 transition-transform duration-500">
            <span class="opacity-90 group-hover:opacity-100 transition-opacity" set:html={icons[feature.icon as keyof typeof icons]} />
          </div>
          
          <!-- Content -->
          <div class="relative z-10 mt-auto space-y-2">
            {feature.size === 'large' && (
              <>
                <h3 class="text-2xl md:text-[2.5rem] font-bold tracking-tight text-white leading-[1.1] group-hover:text-accent transition-colors duration-300 drop-shadow-md">{feature.title}</h3>
                <p class="text-white/70 font-medium text-sm md:text-base hidden sm:block leading-relaxed max-w-md">{feature.desc}</p>
              </>
            )}
            {feature.size === 'tall' && (
              <>
                <h3 class="text-xl md:text-[1.75rem] font-bold tracking-tight text-white leading-tight group-hover:text-accent transition-colors duration-300 drop-shadow-md">{feature.title}</h3>
                <p class="text-white/60 text-[13px] md:text-sm font-medium hidden sm:block leading-relaxed">{feature.desc}</p>
              </>
            )}
            {(feature.size === 'small' || feature.size === 'wide') && (
              <>
                <h3 class="text-lg md:text-xl font-bold tracking-tight text-white group-hover:text-accent transition-colors duration-300 drop-shadow-md">{feature.title}</h3>
                {feature.desc && <p class="text-white/60 text-[12px] md:text-[13px] font-medium hidden sm:block leading-relaxed">{feature.desc}</p>}
              </>
            )}
            
            <p class="text-white/70 font-medium text-sm sm:hidden leading-relaxed mt-2">{feature.desc}</p>
          </div>
          
        </div>
      ))}

    </div>

  </div>
</section>
