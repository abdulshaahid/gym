---
---
<section class="relative min-h-[95vh] flex items-center pt-32 pb-20 lg:pt-40 lg:pb-32 px-5 md:px-12 overflow-hidden bg-background">
  <!-- Subtle ambient glow -->
  <div class="absolute top-[-20%] left-[-10%] w-[600px] h-[600px] bg-accent/[0.04] rounded-full blur-[150px] pointer-events-none"></div>
  <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] bg-accent/[0.02] rounded-full blur-[120px] pointer-events-none"></div>
  
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(212,175,55,0.03)_0%,transparent_60%)] pointer-events-none"></div>
  <div class="absolute inset-0" style="background-image: radial-gradient(circle, var(--dot-color) 1px, transparent 1px); background-size: var(--dot-gap) var(--dot-gap);"></div>

  <div class="max-w-[1400px] mx-auto w-full grid grid-cols-1 xl:grid-cols-[1.1fr_0.9fr] gap-12 xl:gap-20 items-center relative z-10">
    
    <!-- Left: Typography & CTAs -->
    <div class="flex flex-col items-center xl:items-start gap-6 md:gap-8 relative z-20">
      
      
      <h1 data-animate="fade-up" style="--stagger:1" class="font-black tracking-[-0.03em] leading-[1.05] break-words text-center xl:text-left flex flex-col gap-1 md:gap-2">
        <div class="flex flex-col items-center xl:items-start mb-4 md:mb-6">
          <span id="title-fortura" class="text-[3.7rem] sm:text-[5rem] md:text-[6.5rem] lg:text-[7.5rem] font-black text-gradient-gold leading-none drop-shadow-2xl uppercase inline-block pt-4 -mt-4">Fortura</span>
          <div class="w-full flex justify-between text-base md:text-lg lg:text-[1.8rem] font-bold text-white uppercase mt-1 opacity-90 leading-none">
            <span>G</span><span>L</span><span>O</span><span>B</span><span>A</span><span>L</span><span class="w-2 md:w-4"></span><span>E</span><span>X</span><span>I</span><span>M</span>
          </div>
        </div>
        <span class="text-xl md:text-2xl lg:text-3xl block font-bold tracking-normal uppercase">
          <span class="text-white/50">Premium Imported</span> <br /> <span class="text-accent drop-shadow-[0_0_8px_rgba(212,175,55,0.4)]">commercial Equipments.</span>
        </span>
      </h1>

      <!-- Mobile Only Grid -->
      <div data-animate="fade-up" style="--stagger:1.5" class="grid xl:hidden grid-cols-2 gap-3 sm:gap-4 relative w-full mt-2 mb-2">
        <!-- Glow behind grid -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[80%] bg-accent/10 blur-[80px] rounded-full pointer-events-none z-0"></div>

        <!-- Column 1 (Shifted down) -->
        <div class="flex flex-col gap-3 sm:gap-4 translate-y-6">
          <!-- Image 1: Tall (Gym Equipment) -->
          <div class="rounded-2xl overflow-hidden relative group z-10 shadow-2xl h-[200px] sm:h-[300px]">
            <img 
              src="/images/gym-image-15.webp" 
              alt="Premium gym setup" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out opacity-90"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
            <div class="absolute bottom-3 sm:bottom-4 left-3 sm:left-4 right-3">
               <span class="text-white font-bold text-xs sm:text-sm tracking-wide drop-shadow-md">Commercial Grade</span>
            </div>
          </div>
          
          <!-- Stat Block 2: Bottom Left -->
          <div class="bg-surface border border-white/[0.04] rounded-2xl p-4 sm:p-6 flex flex-col justify-center items-center text-center relative overflow-hidden group z-10 shadow-2xl hover:bg-surface-hover transition-colors h-[150px] sm:h-[220px]">
            <div class="absolute -left-4 -top-4 w-24 h-24 bg-accent/10 rounded-full blur-[20px] group-hover:bg-accent/20 transition-colors"></div>
            <p class="text-[2.5rem] sm:text-[3rem] font-black text-white leading-none mb-1 tracking-tighter drop-shadow-md">100<span class="text-accent">%</span></p>
            <p class="text-[9px] sm:text-[10px] text-text-muted font-bold uppercase tracking-[0.15em]">Premium Quality</p>
          </div>
        </div>

        <!-- Column 2 -->
        <div class="flex flex-col gap-3 sm:gap-4">
          <!-- Stat Block: Square -->
          <div class="bg-surface border border-white/[0.04] rounded-2xl p-4 sm:p-6 flex flex-col justify-center items-center text-center relative overflow-hidden group z-10 shadow-2xl hover:bg-surface-hover transition-colors h-[150px] sm:h-[220px]">
            <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-accent/15 rounded-full blur-[20px] group-hover:bg-accent/25 transition-colors"></div>
            <p class="text-[2.5rem] sm:text-[3rem] font-black text-white leading-none mb-1 tracking-tighter drop-shadow-md">500<span class="text-accent">+</span></p>
            <p class="text-[9px] sm:text-[10px] text-text-muted font-bold uppercase tracking-[0.15em]">Equipped</p>
          </div>

          <!-- Image 3: Tall (Detail/Close-up) -->
          <div class="rounded-2xl overflow-hidden relative group z-10 shadow-2xl h-[200px] sm:h-[300px]">
            <img 
              src="/images/gym-image-16.webp" 
              alt="Gym equipment detail" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out opacity-90"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
            <div class="absolute bottom-3 sm:bottom-4 left-3 sm:left-4 right-3 flex items-center justify-between">
               <span class="text-white font-bold text-xs sm:text-sm tracking-wide drop-shadow-md">Factory Pricing</span>
               <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-white/10 backdrop-blur flex items-center justify-center text-white hidden sm:flex">
                 <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
               </div>
            </div>
          </div>
        </div>

      </div>
      
      <p data-animate="fade-up" style="--stagger:2" class="text-lg md:text-xl text-text-muted max-w-xl leading-relaxed font-medium text-center xl:text-left mt-2 md:mt-4">
        <span class="text-white font-semibold">Direct Importers</span> of premium equipment from <span class="text-white font-semibold">global factories</span>. Benefit from <span class="text-accent font-semibold">wholesale pricing</span> and end-to-end <span class="text-white font-semibold">Pan-India & Global installation</span>.
      </p>
      
      <div data-animate="fade-up" style="--stagger:3" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2 md:pt-4 w-full sm:w-auto">
        <a href="/Catalogue%20new.pdf" download class="download-btn flex items-center justify-center gap-4 bg-accent hover:bg-accent-hover text-black px-8 md:px-9 py-4 md:py-4 rounded-full text-base md:text-lg font-bold transition-all duration-300 hover:shadow-[0_0_40px_rgba(212,175,55,0.25)] hover:-translate-y-0.5 relative overflow-hidden">
          <span class="relative z-10 flex items-center gap-4">
            Download Catalogue
            <span class="w-7 h-7 rounded-full bg-black/20 text-black flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            </span>
          </span>
        </a>
        <a href="#contact" style="-webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);" class="flex items-center justify-center gap-3 bg-[#252525] hover:bg-white/[0.08] border border-white/[0.05] text-white px-8 md:px-9 py-4 md:py-4 rounded-full text-base md:text-lg font-bold transition-all duration-300 hover:-translate-y-0.5 backdrop-blur-md">
          Get Bulk Quote
        </a>
      </div>
    </div>

    <!-- Right: Irregular Masonry Grid (Desktop Only) -->
    <div data-animate="fade-left" style="--stagger:2" class="hidden xl:grid grid-cols-2 gap-6 relative w-full">
      <!-- Glow behind grid -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[80%] bg-accent/10 blur-[80px] rounded-full pointer-events-none z-0"></div>

      <!-- Column 1 (Shifted down) -->
      <div class="flex flex-col gap-3 sm:gap-4 lg:gap-6 translate-y-6 lg:translate-y-12">
        <!-- Image 1: Tall (Gym Equipment) -->
        <div class="rounded-2xl lg:rounded-[2rem] overflow-hidden relative group z-10 shadow-2xl h-[200px] sm:h-[300px] lg:h-[300px]">
          <img 
            src="/images/gym-image-15.webp" 
            alt="Premium gym setup" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out opacity-90"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
          <div class="absolute bottom-3 sm:bottom-4 lg:bottom-6 left-3 sm:left-4 lg:left-6 right-3">
             <span class="text-white font-bold text-xs sm:text-sm lg:text-lg tracking-wide drop-shadow-md">Commercial Grade</span>
          </div>
        </div>
        
        <!-- Stat Block 2: Bottom Left -->
        <div class="bg-surface border border-white/[0.04] rounded-2xl lg:rounded-[2rem] p-4 sm:p-6 lg:p-8 flex flex-col justify-center items-center text-center relative overflow-hidden group z-10 shadow-2xl hover:bg-surface-hover transition-colors h-[150px] sm:h-[220px] lg:h-[200px]">
          <div class="absolute -left-4 -top-4 lg:-left-8 lg:-top-8 w-24 h-24 lg:w-32 lg:h-32 bg-accent/10 rounded-full blur-[20px] lg:blur-[30px] group-hover:bg-accent/20 transition-colors"></div>
          <p class="text-[2.5rem] sm:text-[3rem] lg:text-[4.5rem] font-black text-white leading-none mb-1 lg:mb-2 tracking-tighter drop-shadow-md">100<span class="text-accent">%</span></p>
          <p class="text-[9px] sm:text-[10px] lg:text-xs text-text-muted font-bold uppercase tracking-[0.15em] lg:tracking-[0.2em]">Premium Quality</p>
        </div>
      </div>

      <!-- Column 2 -->
      <div class="flex flex-col gap-3 sm:gap-4 lg:gap-6">
        <!-- Stat Block: Square -->
        <div class="bg-surface border border-white/[0.04] rounded-2xl lg:rounded-[2rem] p-4 sm:p-6 lg:p-8 flex flex-col justify-center items-center text-center relative overflow-hidden group z-10 shadow-2xl hover:bg-surface-hover transition-colors h-[150px] sm:h-[220px] lg:h-[200px]">
          <div class="absolute -right-4 -bottom-4 lg:-right-8 lg:-bottom-8 w-24 h-24 lg:w-32 lg:h-32 bg-accent/15 rounded-full blur-[20px] lg:blur-[30px] group-hover:bg-accent/25 transition-colors"></div>
          <p class="text-[2.5rem] sm:text-[3rem] lg:text-[4.5rem] font-black text-white leading-none mb-1 lg:mb-2 tracking-tighter drop-shadow-md">100<span class="text-accent">+</span></p>
          <p class="text-[9px] sm:text-[10px] lg:text-xs text-text-muted font-bold uppercase tracking-[0.15em] lg:tracking-[0.2em]">Equipped</p>
        </div>

        <!-- Image 3: Tall (Detail/Close-up) -->
        <div class="rounded-2xl lg:rounded-[2rem] overflow-hidden relative group z-10 shadow-2xl h-[200px] sm:h-[300px] lg:h-[300px]">
          <img 
            src="/images/gym-image-16.webp" 
            alt="Gym equipment detail" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out opacity-90"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
          <div class="absolute bottom-3 sm:bottom-4 lg:bottom-6 left-3 sm:left-4 lg:left-6 right-3 flex items-center justify-between">
             <span class="text-white font-bold text-xs sm:text-sm lg:text-lg tracking-wide drop-shadow-md">Factory Pricing</span>
             <div class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 rounded-full bg-white/10 backdrop-blur flex items-center justify-center text-white hidden sm:flex">
               <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
             </div>
          </div>
        </div>
      </div>

    </div>
    
  </div>
</section>
