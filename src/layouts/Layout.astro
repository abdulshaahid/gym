---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Fortura Global Exim — Trusted direct importer and wholesale supplier of premium commercial gym equipment. Factory-direct pricing, Global & Pan-India delivery." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href="https://forturaglobal.com/" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://forturaglobal.com/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Fortura Global Exim — Trusted direct importer and wholesale supplier of premium commercial gym equipment. Factory-direct pricing, Global & Pan-India delivery." />
		<meta property="og:image" content="https://forturaglobal.com/fortura.jpeg" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://forturaglobal.com/" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content="Fortura Global Exim — Trusted direct importer and wholesale supplier of premium commercial gym equipment. Factory-direct pricing, Global & Pan-India delivery." />
		<meta property="twitter:image" content="https://forturaglobal.com/fortura.jpeg" />
		
		<!-- Favicons -->
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#050505" />

		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap.xml" />
		<title>{title}</title>
		<ClientRouter />

	</head>
	<body class="bg-background text-text-main selection:bg-accent selection:text-background font-sans">
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
		<FloatingActions />

		<script>
      function initDownloadAnimations() {
        const btns = document.querySelectorAll('.download-btn');
        btns.forEach(btn => {
          if (btn.hasAttribute('data-dl-anim-init')) return;
          btn.setAttribute('data-dl-anim-init', 'true');
          
          btn.addEventListener('click', function(e) {
            if (this.classList.contains('is-downloading')) return;
            this.classList.add('is-downloading');
            
            this.style.transform = 'scale(0.95)';
            setTimeout(() => this.style.transform = '', 150);

            const overlay = document.createElement('div');
            overlay.className = 'absolute inset-0 bg-[#25D366] text-white flex items-center justify-center z-50 transition-all duration-500 ease-out translate-y-full';
            overlay.innerHTML = `
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="animate-[bounce_1s_infinite] mr-2"><path d="M20 6 9 17l-5-5"/></svg>
              <span class="font-bold tracking-wide text-sm">Downloading...</span>
            `;
            
            this.appendChild(overlay);
            
            requestAnimationFrame(() => {
              overlay.classList.remove('translate-y-full');
              overlay.classList.add('translate-y-0');
            });
            
            setTimeout(() => {
              overlay.classList.remove('translate-y-0');
              overlay.classList.add('-translate-y-full');
              
              setTimeout(() => {
                overlay.remove();
                this.classList.remove('is-downloading');
              }, 500);
            }, 2500);
          });
        });
      }

			function initAnimations() {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.1, rootMargin: '0px 0px -20px 0px' }
				);
				document.querySelectorAll('[data-animate]').forEach((el) => {
					// Remove is-visible in case it's a re-render from view transition
					el.classList.remove('is-visible');
					observer.observe(el);
				});
			}

			// Run on initial load and view transitions
			initAnimations();
      initDownloadAnimations();
			
			document.addEventListener('astro:page-load', () => {
        initAnimations();
        initDownloadAnimations();
      });
		</script>
	</body>
</html>
